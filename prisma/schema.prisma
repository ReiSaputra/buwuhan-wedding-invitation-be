// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum PlatformRole {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PRO
  MAX
}

model User {
  id String @id @default(cuid())

  fullName     String
  email        String       @unique @db.Citext
  passwordHash String
  role         PlatformRole @default(USER)
  planTier     PlanTier     @default(FREE)

  invitations Invitation[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Template {
  id String @id @default(cuid())

  name            String
  slug            String   @unique
  tier            PlanTier
  previewImageUrl String
  isActive        Boolean  @default(true)

  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}

enum InvitationStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

model Invitation {
  id String @id @default(cuid())

  title          String
  slug           String           @unique
  status         InvitationStatus @default(DRAFT)
  publishedAt    DateTime?
  eventDate      DateTime?
  eventTime      String?
  venue          String?
  address        String?
  additionalInfo Json

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  couples       Couple[]
  guests        Guest[]
  rsvps         RSVP[]
  galleryPhotos GalleryPhoto[]
  loveStories   LoveStory[]
  buwuhans      Buwuhan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitations")
}

enum CoupleType {
  BRIDE
  GROOM
}

model Couple {
  id String @id @default(cuid())

  name       String
  type       CoupleType
  fatherName String
  motherName String

  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])

  @@map("bride_and_grooms")
}

model Guest {
  id String @id @default(cuid())

  name         String
  category     String?
  phone        String?
  email        String?
  notes        String?
  qrCode       String    @unique
  paxCount     Int       @default(1)
  paxActual    Int?
  isAttended   Boolean   @default(false)
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsvps RSVP[]

  @@index([invitationId])
  @@map("guests")
}

enum RSVPStatus {
  CONFIRMED
  DECLINED
}

model RSVP {
  id String @id @default(cuid())

  status      RSVPStatus
  reservation Int        @default(1)
  message     String?

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invitationId, guestId])
  @@index([invitationId])
  @@map("rsvps")
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  refreshTokenHash String  @unique
  userAgent        String?
  ipAddress        String?

  revokedAt DateTime?
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model GalleryPhoto {
  id       String  @id @default(cuid())
  imageUrl String
  caption  String?
  order    Int     @default(0)

  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationId])
  @@map("gallery_photos")
}

model LoveStory {
  id         String  @id @default(cuid())
  yearOrDate String
  title      String
  story      String
  imageUrl   String?
  order      Int     @default(0)

  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationId])
  @@map("love_stories")
}

model Buwuhan {
  id           String   @id @default(cuid())
  invitationId String

  giverName  String
  note       String?
  receivedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  items      BuwuhanItem[]

  @@index([invitationId])
  @@map("buwuhans")
}

model BuwuhanItem {
  id        String @id @default(cuid())
  buwuhanId String

  itemName       String
  quantity       Decimal
  unit           String
  category       String?
  estimatedValue Decimal?

  createdAt DateTime @default(now())

  buwuhan Buwuhan @relation(fields: [buwuhanId], references: [id], onDelete: Cascade)

  @@index([buwuhanId])
  @@map("buwuhan_items")
}
