// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum PlatformRole {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PRO
  MAX
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum PaymentProvider {
  MIDTRANS
}

model User {
  id String @id @default(cuid())

  fullName     String
  email        String       @unique @db.Citext
  passwordHash String
  role         PlatformRole @default(USER)
  planTier     PlanTier     @default(FREE)

  invitations   Invitation[]
  sessions      Session[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum EventCategory {
  WEDDING
  KHITANAN
  RASULAN
  AQIQAH
}

model Template {
  id String @id @default(cuid())

  name            String
  slug            String        @unique
  tier            PlanTier
  eventCategory   EventCategory @default(WEDDING)
  previewImageUrl String
  isActive        Boolean       @default(true)

  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}

enum InvitationStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

model Invitation {
  id String @id @default(cuid())

  title          String
  slug           String           @unique
  status         InvitationStatus @default(DRAFT)
  eventCategory  EventCategory    @default(WEDDING)
  publishedAt    DateTime?
  eventDate      DateTime?
  eventTime      String?
  venue          String?
  address        String?
  giftAddress    String?
  additionalInfo Json

  // Restrict: Template yang sedang digunakan undangan tidak boleh dihapus demi menjaga integritas data
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // Cascade: Bila akun pengguna dihapus, seluruh undangan miliknya ikut terhapus
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  couples       Couple[]
  guests        Guest[]
  rsvps         RSVP[]
  galleryPhotos GalleryPhoto[]
  loveStories   LoveStory[]
  buwuhans      Buwuhan[]
  giftAccounts  GiftAccount[]
  gifts         Gift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitations")
}

enum CoupleType {
  BRIDE
  GROOM
}

model Couple {
  id String @id @default(cuid())

  name       String
  type       CoupleType
  fatherName String
  motherName String

  // Cascade: Data mempelai adalah bagian dari undangan, wajib ikut terhapus saat undangan dihapus
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("bride_and_grooms")
}

model Guest {
  id String @id @default(cuid())

  name         String
  category     String?
  phone        String?
  email        String?
  notes        String?
  qrCode       String    @unique
  paxCount     Int       @default(1)
  paxActual    Int?
  isAttended   Boolean   @default(false)
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  // Cascade: Tamu undangan terikat pada undangan spesifik; ikut terhapus saat undangan dihapus
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsvps RSVP[]

  @@index([invitationId])
  @@map("guests")
}

enum RSVPStatus {
  CONFIRMED
  DECLINED
}

model RSVP {
  id String @id @default(cuid())

  status      RSVPStatus
  reservation Int        @default(1)
  message     String?

  // Cascade: RSVP terikat pada tamu; ikut terhapus bila data tamu dihapus
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  // Cascade: RSVP terikat pada undangan; ikut terhapus bila undangan dihapus
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invitationId, guestId])
  @@index([invitationId])
  @@map("rsvps")
}

model Session {
  id String @id @default(cuid())

  // Cascade: Sesi login pengguna otomatis terhapus saat akun pengguna dihapus
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String  @unique
  userAgent        String?
  ipAddress        String?

  revokedAt DateTime?
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model GalleryPhoto {
  id       String  @id @default(cuid())
  imageUrl String
  caption  String?
  order    Int     @default(0)

  // Cascade: Foto galeri terhapus saat undangan dihapus
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationId])
  @@map("gallery_photos")
}

model LoveStory {
  id         String  @id @default(cuid())
  yearOrDate String
  title      String
  story      String
  imageUrl   String?
  order      Int     @default(0)

  // Cascade: Cerita cinta terhapus saat undangan dihapus
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationId])
  @@map("love_stories")
}

model Buwuhan {
  id           String @id @default(cuid())
  invitationId String

  giverName  String
  note       String?
  receivedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade: Catatan buwuhan terhapus saat undangan dihapus
  invitation Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  items      BuwuhanItem[]

  @@index([invitationId])
  @@map("buwuhans")
}

model BuwuhanItem {
  id        String @id @default(cuid())
  buwuhanId String

  itemName       String
  quantity       Decimal
  unit           String
  category       String?
  estimatedValue Decimal?

  createdAt DateTime @default(now())

  // Cascade: Item buwuhan terhapus saat entitas buwuhan dihapus
  buwuhan Buwuhan @relation(fields: [buwuhanId], references: [id], onDelete: Cascade)

  @@index([buwuhanId])
  @@map("buwuhan_items")
}

enum GiftMethod {
  CASH
  TRANSFER
  EWALLET
}

model GiftAccount {
  id           String @id @default(cuid())
  invitationId String

  bankName      String
  accountNumber String
  accountHolder String
  type          String @default("BANK")
  order         Int    @default(0)

  // Cascade: Rekening kado terhapus saat undangan dihapus
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationId])
  @@map("gift_accounts")
}

model Gift {
  id           String @id @default(cuid())
  invitationId String

  giverName  String
  amount     Decimal    @db.Decimal(12, 2)
  method     GiftMethod @default(TRANSFER)
  note       String?
  receivedAt DateTime   @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade: Catatan hadiah terhapus saat undangan dihapus
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("gifts")
}

// ── Subscription System ──────────────────────────────────────────────────────

model Plan {
  code     String        @id // "FREE" | "PRO" | "MAX"
  name     String
  price    Decimal       @db.Decimal(12, 2)
  currency String        @default("IDR")
  period   BillingPeriod
  features Json // string[] — daftar fitur yang ditampilkan di UI
  isActive Boolean       @default(true)
  tier     PlanTier      @unique

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planCode String
  plan     Plan   @relation(fields: [planCode], references: [code])

  status    SubscriptionStatus @default(PENDING)
  startedAt DateTime?
  expiresAt DateTime?

  provider    PaymentProvider?
  providerRef String? // order_id dari Midtrans

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id             String @id @default(cuid())
  subscriptionId String
  userId         String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("IDR")

  status     InvoiceStatus @default(PENDING)
  paidAt     DateTime?
  rawPayload Json? // payload mentah dari webhook gateway

  // Kunci idempotency — sama dengan order_id Midtrans; cegah double-processing
  idempotencyKey String @unique

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@map("invoices")
}
