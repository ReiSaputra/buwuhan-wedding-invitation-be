// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum PlatformRole {
  USER
}

model User {
  id String @id @default(cuid())

  fullName     String
  email        String       @unique @db.Citext
  passwordHash String
  role         PlatformRole @default(USER)

  invitations Invitation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]

  @@map("users")
}

model Invitation {
  id String @id @default(cuid())

  title          String
  slug           String    @unique
  isPublished    Boolean
  publishedAt    DateTime?
  additionalInfo Json

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id])

  guests Guest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitations")
}

enum CoupleType {
  BRIDE
  GROOM
}

model Couple {
  id String @id @default(cuid())

  name       String
  type       CoupleType
  fatherName String
  motherName String

  invitations Invitation[]

  @@map("bride_and_grooms")
}

model Guest {
  id String @id @default(cuid())

  name   String
  phone  String
  email  String
  qrCode String @unique

  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rsvps     RSVP[]

  @@map("guests")
}

enum RSVPStatus {
  CONFIRMED
  DECLINED
}

model RSVP {
  id String @id @default(cuid())

  status      RSVPStatus
  reservation Int

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rsvps")
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  refreshTokenHash String  @unique
  userAgent        String?
  ipAddress        String?

  revokedAt DateTime?
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}
