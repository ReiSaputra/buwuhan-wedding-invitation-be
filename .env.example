# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# App 
NODE_ENV=development
PORT=3000

# Auth (JWT)
# WAJIB diganti dengan string random panjang & unik, jangan pernah pakai
# nilai contoh ini di production. Generate dengan misal:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti-dengan-secret-random-yang-panjang

# CORS
# Origin frontend yang boleh akses API ini (dibutuhkan untuk cookie
# httpOnly refresh token bisa terkirim -- credentials: true).
# Local dev, sesuaikan port frontend kamu:
FRONTEND_URL=http://localhost:5173

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="email-anda@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Buwuhan Wedding Invitation <email-anda@gmail.com>"

FRONTEND_URL="http://localhost:5173"